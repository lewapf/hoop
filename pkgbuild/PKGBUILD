pkgname=hoop
pkgver=0.1.0
pkgrel=1
pkgdesc='Preview embroidery files on Janome hoops'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'wayland' 'xdg-desktop-portal')
makedepends=('cargo')
options=('!lto' '!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/hoop "$pkgdir/usr/bin/hoop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/hoop.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hoop.svg"
  install -Dm644 "$startdir/hoop.desktop" "$pkgdir/usr/share/applications/hoop.desktop"
  install -Dm644 "$startdir/hoop.xml" "$pkgdir/usr/share/mime/packages/hoop.xml"
}
